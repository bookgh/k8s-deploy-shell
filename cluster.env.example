# Copy to cluster.env; parsed as data, never sourced.
CLUSTER_NAME=example
INSTALL_NODE_ADVERTISE_ADDR=192.0.2.10
CONTROL_PLANE_ENDPOINT=192.0.2.100
CONTROL_PLANE_PORT=6443
CONTROLLER_MANAGER_PORT=10257
SCHEDULER_PORT=10259
KUBERNETES_CONFIG_DIR=/etc/kubernetes
KUBERNETES_LOG_DIR=/var/log/kubernetes
KUBERNETES_DATA_DIR=/var/lib/kubernetes
KUBERNETES_BIN_DIR=/usr/local/bin
ARTIFACT_HTTP_PORT=2026
ARTIFACT_HTTP_ROOT=/var/lib/k8s-deploy-shell/artifacts/cache
INSTALL_ROOT=./
REMOTE_INSTALL_ROOT=/opt/k8s-deploy-shell
SSH_USER=root
SSH_PORT=22
SSH_CONNECT_TIMEOUT=8
SSH_RETRIES=3
SSH_BACKOFF_SECONDS=2
SSH_KNOWN_HOSTS_FILE=./config/known_hosts
NODE_INVENTORY_FILE=./config/nodes.tsv.example
PKI_ROOT=./pki
OUTPUT_ROOT=./output
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
CLUSTER_DNS=10.96.0.10
KUBERNETES_SERVICE_IP=10.96.0.1
CLUSTER_DOMAIN=cluster.local
RUNTIME=containerd
KUBE_PROXY_MODE=nftables
IMAGE_MODE=local-import
ENABLE_HARBOR=false
ENABLE_FIREWALL_CONFIG=false
DISABLE_SELINUX=false
DRY_RUN=true
MASTERS=master-1
WORKERS=worker-1
ETCD_NODES=master-1
ETCD_DATA_DIR=/var/lib/etcd
ETCD_CONFIG_DIR=/etc/etcd
ETCD_BACKUP_DIR=/var/backups/etcd
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
ETCD_LOG_LEVEL=info
ETCD_AUTO_COMPACTION_RETENTION=8h
CONTAINERD_CONFIG_DIR=/etc/containerd
CONTAINERD_BIN_DIR=/usr/local/bin
CONTAINERD_ROOT_DIR=/var/lib/containerd
CONTAINERD_STATE_DIR=/run/containerd
CNI_BIN_DIR=/opt/cni/bin
CNI_CONF_DIR=/etc/cni/net.d
KUBELET_DATA_DIR=/var/lib/kubelet
KUBELET_MAX_PODS=110
KUBELET_POD_PIDS_LIMIT=4096
KUBELET_PORT=10250
KUBELET_BIND_ADDRESS=0.0.0.0
KUBE_PROXY_HEALTHZ_PORT=10256
KUBE_PROXY_METRICS_PORT=10249
NGINX_PREFIX=/usr/local/nginx-stream
NGINX_BIN=/usr/local/sbin/nginx
NGINX_CONFIG_DIR=/etc/nginx
NGINX_LOG_DIR=/var/log/nginx
NGINX_PID_FILE=/run/nginx.pid
NGINX_WORKER_CONNECTIONS=4096
NGINX_PROXY_CONNECT_TIMEOUT=2s
NGINX_PROXY_TIMEOUT=1h
NGINX_UPSTREAM_MAX_FAILS=3
NGINX_UPSTREAM_FAIL_TIMEOUT=10s
NGINX_NEXT_UPSTREAM_TRIES=3
NGINX_NEXT_UPSTREAM_TIMEOUT=5s
